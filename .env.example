# Copy to .env.local (gitignored) and fill in the values you need. `sos` reads ./.env.local at startup;
# variables already set in your shell win. Never commit real values.

# Pinball Map API token (request at https://pinballmap.com/api_token) for the pinball_map recipe.
PINBALLMAP_API_TOKEN=

# Optional: where downloads are cached (default ~/.cache/sosforge).
SOSFORGE_CACHE=

# Optional: your own Overpass API endpoint for heavy OpenStreetMap queries.
SOSFORGE_OVERPASS_URL=

# Optional: an Ask & Answer API base for `sos site` other than site/site.toml's ask_base (`--no-ask` builds without one).
SOSFORGE_ASK_BASE=
